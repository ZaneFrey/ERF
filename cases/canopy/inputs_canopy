# ------------------  GOVERNING EQUATIONS  -------------------
erf.anelastic = 1
erf.use_fft   = true

stop_time = 43200.0

amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024

# ------------------  PROBLEM SIZE & GEOMETRY  -------------------
geometry.prob_extent =  2808.0 2808.0  600.0
amr.n_cell           =   280    280     150
amr.max_level        = 0

geometry.is_periodic = 1 1 0

# ------------------  BOUNDARY CONDITIONS  -------------------
zlo.type = "surface_layer"
erf.most.z0 = 0.001

zhi.type = "SlipWall"
zhi.theta_grad = 0.0

# ------------------  TIME STEP CONTROL  -------------------
erf.cfl = 0.3
#erf.fixed_dt = 0.1

# ------------------  FORCING TERMS  -------------------
erf.use_gravity  = true

erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 45.0
erf.rotational_time_period = 86400
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 10.0 0.0 0.0

# ------------------  TOP RAYLEIGH DAMPING  -------------------
rayleigh_damp_U = false
rayleigh_damp_V = false
rayleigh_damp_W = true
rayleigh_damp_T = false
erf.rayleigh_dampcoef  = 0.003      
erf.rayleigh_zdamp     = 120.0       
#erf.rayleigh_damping_type = "FastImplicit"   # optional

# ------------------  FOREST MODULE  -------------------
erf.forest_file     = "forest_domain_tt2"
erf.forest_geometry = true
# Apply canopy drag in the slow step unless substepping is needed later.
erf.forest_substep  = true

# ------------------  NUMERICAL SCHEMES  -------------------
erf.les_type    = "Smagorinsky"
erf.Cs          = 0.17

erf.molec_diff_type = "None"

#erf.dycore_horiz_adv_type  = "Centered_6th"
#erf.dycore_vert_adv_type   = "Centered_6th"
#erf.dryscal_horiz_adv_type = "Centered_6th"
#erf.dryscal_vert_adv_type  = "Centered_6th"

erf.dycore_horiz_adv_type  = "Blended_5th6th"
erf.dycore_vert_adv_type   = "Blended_5th6th"
erf.dryscal_horiz_adv_type = "Blended_5th6th"
erf.dryscal_vert_adv_type  = "Blended_5th6th"
erf.dycore_horiz_upw_frac  = 0.2
erf.dycore_vert_upw_frac   = 0.2
erf.dryscal_horiz_upw_frac = 0.2
erf.dryscal_vert_upw_frac  = 0.2

# ------------------  INITIAL CONDITIONS  -------------------
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding"

# Turbulence seeding: divergence-free sinusoidal velocity perturbations
prob.pert_ref_height = 480.0
prob.pert_deltaU = 1.0
prob.pert_deltaV = 1.0
prob.pert_periods_U = 35.0
prob.pert_periods_V = 35.0

# Turbulence seeding: random theta perturbations (not rho*theta)
prob.T_0_Pert_Mag = 1.0
prob.pert_rhotheta = false

# ------------------  OUTPUTS  -------------------
erf.sum_interval    = 50
erf.v               = 1
amr.v               = 1

erf.check_file      = chk
erf.check_per       = 1800

erf.time_avg_vel    = true

erf.plot_file_1     = plt
erf.plot_per_1      = 300
erf.plot_vars_1     = x_velocity y_velocity z_velocity magvel u_t_avg v_t_avg w_t_avg umag_t_avg 
erf.data_log        = surf_hist.dat mean_profiles.dat flux_profiles.dat sfs_profiles.dat
erf.profile_int     = 300

# ------------------  2D SLICES  -------------------
