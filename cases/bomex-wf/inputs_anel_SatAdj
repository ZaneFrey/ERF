# ------------------  INPUTS TO MAIN PROGRAM  -------------------
erf.prob_name = "BOMEX"

amrex.fpe_trap_invalid = 0

fabarray.mfiter_tile_size = 1024 1024 1024


# ------------------  GOVERNING EQUATIONS  -------------------
erf.anelastic = 1
erf.use_fft   = true

# ------------------  PROBLEM SIZE & GEOMETRY  -------------------
# Domain / base resolution
geometry.prob_extent = 6400 6400 4000
amr.n_cell           =  400  400  800

# AMR hierarchy: 20 -> 10 -> 5 in z only
amr.max_level      = 0
#amr.ref_ratio_vect = 1 1 2  1 1 2
#erf.dt_ref_ratio   = 2 2
#erf.regrid_int     = 10
#amr.n_error_buf    = 0

# Keep flat/non-terrain mesh for MOST compatibility
#erf.terrain_type   = None

geometry.is_periodic = 1 1 0


# ------------------  BOUNDARY CONDITIONS  -------------------

# MOST BOUNDARY (DEFAULT IS ADIABATIC FOR THETA)
zlo.type = "surface_layer"
erf.surface_layer.flux_type = "custom"
erf.most.ustar  = 0.28   # ustar
erf.most.tstar  = 8.0e-3 # theta flux
erf.most.qstar  = 5.2e-5 # qv    flux
erf.most.z0     = 0.1
erf.most.zref   = 20.0

# NOTE: This should have a qv grad too (use hoextrapcc?!)
zhi.type = "SlipWall"
#zhi.theta_grad = 0.00365


# ------------------  TIME STEP CONTROL  -------------------

#stop_time = 3600    #  1 hour
#stop_time = 4800    #  1.5 hours
#stop_time = 7200    #  2 hours
#stop_time = 21600   #   6 hours
#stop_time = 36000   #   10 hours
stop_time = 43200    #  12 hours

erf.cfl = 0.3


# ------------------  FORCING TERMS  -------------------
erf.alpha_T = 0.0
erf.alpha_C = 0.0
erf.use_gravity = true

erf.use_coriolis    = true
erf.coriolis_3d     = false
erf.latitude        = 14.982176712702886  # f = 0.376e-4 1/s

erf.add_custom_rhotheta_forcing        = true
erf.add_custom_moisture_forcing        = true
erf.add_custom_geostrophic_profile     = true
erf.add_custom_w_subsidence            = true
erf.custom_forcing_uses_primitive_vars = true

prob.advection_heating_rate   = -2.3148E-5
prob.source_cutoff            = 1500.0
prob.source_cutoff_transition = 1500.0

prob.advection_moisture_rate            = -1.2E-8
prob.moisture_source_cutoff            	= 300.0
prob.moisture_source_cutoff_transition 	= 200.0

prob.wbar_sub_max    = -0.0065
prob.wbar_cutoff_max = 1500.0
prob.wbar_cutoff_min = 2100.0   

prob.custom_TKE      = true


# ------------------  MOISTURE / MICROPHYSICS  -------------------
erf.moisture_model  = "SatAdj"
erf.buoyancy_type   = 4


# ------------------  NUMERICAL SCHEMES  -------------------
#erf.dycore_horiz_adv_type    = Upwind_3rd
#erf.dycore_vert_adv_type     = Upwind_3rd
#erf.dryscal_horiz_adv_type   = Upwind_3rd_SL
#erf.dryscal_vert_adv_type    = Upwind_3rd_SL
#erf.moistscal_horiz_adv_type = Upwind_3rd_SL
#erf.moistscal_vert_adv_type  = Upwind_3rd_SL

erf.dycore_horiz_adv_type  = "Blended_5th6th"
erf.dycore_vert_adv_type   = "Blended_5th6th"
erf.dryscal_horiz_adv_type = "Blended_5th6th"
erf.dryscal_vert_adv_type  = "Blended_5th6th"
erf.dycore_horiz_upw_frac  = 0.25
erf.dycore_vert_upw_frac   = 0.25
erf.dryscal_horiz_upw_frac = 0.25
erf.dryscal_vert_upw_frac  = 0.25

erf.molec_diff_type = "None"

#erf.les_type        = "Smagorinsky"
#erf.Cs              = 0.17

erf.les_type  = "Deardorff"
erf.Ck        = 0.1
erf.sigma_k   = 0.5 
erf.Ce        = 0.93
erf.Ce_wall   = 3.9
erf.theta_ref = 300.0

erf.Pr_t      = 0.33333333333333
erf.Sc_t      = 0.33333333333333


# ------------------  INITIAL CONDITIONS  -------------------
erf.init_type = "input_sounding"
erf.init_sounding_ideal = true

prob.U_0_Pert_Mag = 0.01
prob.V_0_Pert_Mag = 0.01 
prob.W_0_Pert_Mag = 0.0

prob.pert_ref_height = 1600.0
prob.T_0_Pert_Mag    = 0.1
prob.qv_0_Pert_Mag   = 0.000025


# ------------------  WIND FARM (SAD)  -------------------
erf.windfarm_type = "SimpleAD"
erf.windfarm_loc_type = "x_y"
erf.windfarm_loc_table = "turb_loc_xy_10mw.txt"
erf.windfarm_spec_table = "dtu10mw_spec.tbl"
erf.windfarm_start_time = 0
erf.windfarm_ramp_tau   = 60

# Inputs match trade wind direction
erf.sampling_distance_by_D = 1.5
erf.turb_disk_angle_from_x = 270.0

erf.dynamic_yaw = true
erf.yaw_period  = 300
erf.yaw_file    = "turb_yaw.txt"


# ------------------  OUTPUTS  -------------------
 
# DIAGNOSTICS & VERBOSITY
erf.sum_interval   = 1       # timesteps between computing mass
erf.v              = 1       # verbosity in ERF.cpp
amr.v              = 1       # verbosity in Amr.cpp

# CHECKPOINT FILES
erf.check_file      = chk  
erf.check_per       = 1800

# PLOTFILES
erf.plot_file_1     = plt  
erf.plot_per_1      = 15
#erf.plot_vars_1     = density rhotheta x_velocity y_velocity z_velocity pressure temp theta qt qv qc qsat
erf.plot_vars_1     = x_velocity y_velocity z_velocity theta qt qc qsat
erf.data_log        = surf_hist.dat mean_profiles.dat flux_profiles.dat sfs_profiles.dat
erf.profile_int     = 100