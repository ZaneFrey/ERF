         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Journal of Advances in Modeling Earth Systems 000, 3 (2010). doi:</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Margreet C vanZanten, Bjorn Stevens, Louise Nuijens, A Pier Siebesma, A S Ackerman, F Burnet, A Cheng, F Couvreux, H Jiang, M Khairoutdinov, Y Kogan, D C Lewellen, D Mechem, K Nakamura, A Noda, B J Shipway, J Slawinska, S Wang, A Wyszogrodzki</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Controls on precipitation and cloudiness in simulations of tradewind cumulus as observed during RICO</rdf:li>
            </rdf:Alt>
