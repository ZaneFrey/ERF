# Neutral ABL + 1 turbine (Simple Actuator Disk) in anelastic mode.
# Intended to run with the `erf_abl` executable built with:
#   -DERF_ENABLE_FFT=ON -DERF_ENABLE_WINDFARM=ON

# ------------------  GOVERNING EQUATIONS  -------------------
erf.anelastic = 1
erf.use_fft   = true

stop_time = 43200.0

amrex.fpe_trap_invalid = 0
fabarray.mfiter_tile_size = 1024 1024 1024

# ------------------  PROBLEM SIZE & GEOMETRY  -------------------
geometry.prob_extent =  7680.0 7200.0  1500.0
amr.n_cell           =   384    360     150
amr.max_level        = 0

geometry.is_periodic = 1 1 0

# ------------------  BOUNDARY CONDITIONS  -------------------
zlo.type      = "surface_layer"
erf.most.z0   = 0.15

zhi.type = "SlipWall"
zhi.theta_grad = 0.003

# ------------------  TIME STEP CONTROL  -------------------
erf.cfl = 0.4

# ------------------  FORCING TERMS  -------------------
erf.use_gravity  = true

#erf.use_coriolis = false
#erf.abl_driver_type = "PressureGradient"
#erf.abl_pressure_grad = -0.00025 0 0

erf.use_coriolis = true
erf.coriolis_3d  = false
erf.latitude     = 45.0
erf.rotational_time_period = 86400
erf.abl_driver_type = "GeostrophicWind"
erf.abl_geo_wind    = 10.0 0.0 0.0

# ------------------  NUMERICAL SCHEMES  -------------------
erf.les_type  = "Deardorff"
erf.Ck        = 0.1
erf.sigma_k   = 0.5 
erf.Ce        = 0.93
erf.Ce_wall   = 3.9
erf.theta_ref = 300.0

erf.molec_diff_type = "None"

erf.dycore_horiz_adv_type  = "WENOZ7"
erf.dycore_vert_adv_type   = "WENOZ7"
erf.dryscal_horiz_adv_type = "WENOZ7"
erf.dryscal_vert_adv_type  = "WENOZ7"

# ------------------  INITIAL CONDITIONS  -------------------
erf.init_type = "input_sounding"
erf.sounding_type = Ideal
erf.input_sounding_file = "input_sounding"

# Turbulence seeding: divergence-free sinusoidal velocity perturbations
prob.pert_ref_height = 1500.0
prob.pert_deltaU = 0.5
prob.pert_deltaV = 0.5
prob.pert_periods_U = 32.0
prob.pert_periods_V = 32.0

# Turbulence seeding: random theta perturbations (not rho*theta)
prob.T_0_Pert_Mag = 1.0
prob.pert_rhotheta = false

# ------------------  WIND FARM (SIMPLE ACTUATOR DISK)  -------------------
erf.windfarm_type = "SimpleAD"
erf.windfarm_loc_type = "x_y"
erf.windfarm_loc_table = "turb_loc_xy_15mw.txt"
erf.windfarm_spec_table = "iea15mw_spec.tbl"

# Required for SimpleAD
erf.sampling_distance_by_D = 1.5
erf.turb_disk_angle_from_x = 90.0

erf.dynamic_yaw = true
erf.yaw_period  = 300

# ------------------  OUTPUTS  -------------------
erf.sum_interval    = 50
erf.v               = 1
amr.v               = 1

erf.check_file      = chk
erf.check_int       = 2500

erf.time_avg_vel    = true

erf.plot_file_1     = plt
erf.plot_per_1      = 300
erf.plot_vars_1     = x_velocity y_velocity z_velocity vorticity_x vorticity_y vorticity_z umag_t_avg
erf.data_log        = surf_hist.dat mean_profiles.dat flux_profiles.dat sfs_profiles.dat
erf.profile_int     = 500

